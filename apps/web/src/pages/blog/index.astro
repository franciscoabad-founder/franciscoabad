---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const posts = (await getCollection("blog", ({ data }) => data.lang === "en" && (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const fmtDate = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
---

<BaseLayout
  title="Blog · Francisco Abad"
  description="Building in public: what we build at Rafik, what breaks and what I learn along the way."
>
  <Navbar />

  <div class="bg-bg-primary min-h-screen">
    <section class="pt-32 pb-12">
      <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
        <p class="font-montserrat font-semibold uppercase tracking-[3px] text-ember text-[11px] mb-4">BLOG</p>
        <h1 class="font-montserrat font-bold text-text-primary text-[40px] md:text-[56px] leading-tight mb-5">Building in public.</h1>
        <p class="font-inter text-text-secondary text-[17px] leading-relaxed max-w-[640px]">
          What we build, what breaks and what I learn along the way. Notes from the inside of a company building the legal hub for the future.
        </p>
      </div>
    </section>

    <section class="pb-24">
      <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
        {posts.length === 0 ? (
          <div class="max-w-[640px]">
            <p class="font-inter text-text-secondary text-[16px] leading-relaxed mb-6">The first notes are coming soon. Follow along on X and LinkedIn in the meantime.</p>
            <div class="flex flex-wrap gap-4">
              <a href="https://x.com/FranciscoAbadEC" class="font-montserrat font-semibold text-[13px] uppercase tracking-[1.5px] text-white bg-ember px-6 py-3 rounded-md">X</a>
              <a href="https://www.linkedin.com/in/franciscoabadec/" class="font-montserrat font-semibold text-[13px] uppercase tracking-[1.5px] text-ultra-light border border-ember px-6 py-3 rounded-md">LinkedIn</a>
              <a href="/es/blog" class="font-montserrat text-[13px] uppercase tracking-[1.5px] text-text-secondary px-2 py-3">Spanish archive →</a>
            </div>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {posts.map((post) => (
              <a href={`/blog/${post.data.slug}`} class="bg-bg-elevated rounded-lg border border-border-subtle hover:border-ember transition-colors duration-300 p-6 flex flex-col">
                <p class="font-montserrat text-[11px] uppercase tracking-[1.5px] text-text-muted-brand mb-3">{post.data.category} · {fmtDate(post.data.pubDate)} · {post.data.readTime} min</p>
                <h2 class="font-montserrat font-semibold text-text-primary text-[20px] mb-3">{post.data.title}</h2>
                <p class="font-inter text-text-secondary text-[14px] leading-relaxed">{post.data.description}</p>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </div>

  <Footer lang="en" />
</BaseLayout>

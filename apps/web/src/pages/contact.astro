---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const lang = "en";

const reasons = [
  { h: "Rafik", p: "Law firms and partners: write to me about Rafik.", href: "mailto:francisco@rafik.tech?subject=Rafik", cta: "francisco@rafik.tech" },
  { h: "Speaking", p: "Invitations for talks, panels and workshops.", href: "mailto:francisco@rafik.tech?subject=Speaking%20invitation", cta: "Invite me" },
  { h: "Advisory and collaborations", p: "One-on-one sessions and projects to build together.", href: "mailto:francisco@rafik.tech?subject=Advisory%20or%20collaboration", cta: "Write to me" },
];
const socials = [
  { label: "X", href: "https://x.com/FranciscoAbadEC" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/franciscoabadec/" },
  { label: "Instagram", href: "https://www.instagram.com/franciscoabadec/" },
];
---

<BaseLayout
  title="Contact · Francisco Abad"
  description="Write to Francisco Abad about Rafik, speaking invitations, advisory sessions or collaborations."
>
  <Navbar />

  <div class="bg-bg-primary min-h-screen">
    <section class="pt-32 pb-24">
      <div class="max-w-[1000px] mx-auto px-6 lg:px-8">
        <h1 class="font-montserrat font-bold text-text-primary text-[40px] md:text-[56px] leading-tight mb-5">Let's talk.</h1>
        <p class="font-inter text-text-secondary text-[17px] leading-relaxed max-w-[560px] mb-12">
          The fastest way is email. I read everything and answer within a few days.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
          {reasons.map((r) => (
            <a href={r.href} class="bg-bg-elevated rounded-lg border border-border-subtle hover:border-ember transition-colors duration-300 p-7 flex flex-col">
              <h2 class="font-montserrat font-semibold text-text-primary text-[20px] mb-3">{r.h}</h2>
              <p class="font-inter text-text-secondary text-[14px] leading-relaxed flex-1 mb-5">{r.p}</p>
              <span class="font-montserrat font-semibold text-[12px] uppercase tracking-[1.5px] text-ultra-light">{r.cta} →</span>
            </a>
          ))}
        </div>

        <p class="font-montserrat font-semibold text-text-muted-brand text-[11px] uppercase tracking-[2px] mb-5">Follow</p>
        <div class="flex flex-wrap gap-6">
          {socials.map(({ label, href }) => (
            <a href={href} target="_blank" rel="noopener noreferrer" class="font-montserrat text-[13px] uppercase tracking-[1px] text-text-secondary hover:text-ember transition-colors duration-300">{label}</a>
          ))}
        </div>
      </div>
    </section>
  </div>
  <Footer lang={lang} />
</BaseLayout>

---
const projects = [
  {
    name: "Nerio",
    tag: "Producto",
    desc: "Mi chief of staff con IA. Aprueba, no reemplaza.",
  },
  {
    name: "PanchoAtlas",
    tag: "Motor de contenido",
    desc: "El sistema que convierte lo que vivo en contenido, sin publicar a mano.",
  },
  {
    name: "Flow",
    tag: "Open source",
    desc: "Dictado por voz y notas de reunión con IA, 100% local. MIT license.",
  },
  {
    name: "Pancho OS",
    tag: "Sistema personal",
    desc: "El sistema operativo con el que dirijo mi vida y mis empresas.",
  },
];
---

<section id="construyendo" class="bg-bg-elevated py-12 md:py-20 border-t border-border-subtle">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12" data-reveal>
      <div>
        <p class="font-montserrat text-[11px] uppercase tracking-[2px] text-ultra-light mb-3">
          Pruébalo en ti primero
        </p>
        <h2 class="font-montserrat font-bold text-text-primary text-[32px] md:text-[38px] leading-tight max-w-[520px]">
          Lo que estoy construyendo ahora
        </h2>
      </div>
      <a
        href="/portafolio"
        class="font-montserrat font-semibold text-[13px] uppercase tracking-[1.5px] text-ultra-light border border-ember px-7 py-3.5 rounded-md hover:bg-ember hover:text-white transition-all duration-300 whitespace-nowrap self-start md:self-auto"
      >
        Ver el portafolio →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {projects.map((p) => (
        <div class="bg-bg-primary border border-border-subtle rounded-lg p-6 flex flex-col" data-reveal>
          <p class="font-montserrat text-[10px] uppercase tracking-[1.5px] text-champagne mb-3">
            {p.tag}
          </p>
          <p class="font-montserrat font-bold text-text-primary text-[18px] mb-2">
            {p.name}
          </p>
          <p class="font-inter text-text-secondary text-[14px] leading-relaxed">
            {p.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
